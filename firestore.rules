rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/_internal/admin_config) &&
             request.auth.uid in get(/databases/$(database)/documents/_internal/admin_config).data.adminUids;
    }
    
    function getUserStaffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    
    function hasLocationAccess(locationId) {
      let staffData = getUserStaffData();
      return staffData.locationId == 'all_locations' || staffData.locationId == locationId;
    }

    // Check if user is a manager or admin
    function isManagerOrAdmin() {
       // Optimisation: check isAdmin first to avoid extra read if possible, though getUserStaffData is needed for manager check
       // Note: in production rules, caching or custom claims are better for this.
       // Here we rely on the staff document.
       return isAdmin() || (isAuthenticated() && getUserStaffData().role in ['manager', 'admin']);
    }

    // --- Collection Rules ---

    // Staff collection
    match /staff/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    
    // Locations
    match /locations/{locationId} {
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
      match /items/{itemId} {
        allow read: if isAuthenticated() && hasLocationAccess(locationId);
        allow create, update: if isAuthenticated() && hasLocationAccess(locationId);
        allow delete: if isAdmin();
      }
    }
    
    // Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Wastage
    match /wastage/{wasteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // --- Allergens Module Rules (Tasks 9) ---

    // Menu Items: Admin writes, Staff reads
    match /menuItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Covers create/update/delete
    }
    
    // Allergen Versions: Admin writes (publish), Staff reads
    match /allergenVersions/{versionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // FSA Allergens: Read only for most, Admin writes
    match /allergens/{allergenId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Allergy Incidents
    // Create: Any authenticated staff (Task 7 requirement)
    // Read/Update/Delete: Manager or Admin only
    match /allergyIncidents/{incidentId} {
      allow create: if isAuthenticated() &&
                      request.resource.data.keys().hasAll(['store', 'outcome', 'actionTaken']) &&
                      request.resource.data.outcome in ['served_safely', 'refused', 'escalated'] &&
                      request.resource.data.notes.size() < 1000; // Basic length cap

      allow read: if isManagerOrAdmin();
      allow update, delete: if isManagerOrAdmin();
    }

    // Training Modules
    match /trainingModules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAdmin();
    }

    // Training Acknowledgements (Task 9)
    // Create: Only for own UID, immutable (cannot update/delete unless admin)
    match /trainingAcks/{ackId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isManagerOrAdmin());
      allow create: if isAuthenticated() &&
                      request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- End Allergens Module ---

    // Loyalty
    match /loyaltyCards/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated();
    }
    
    match /loyaltyPrograms/{programId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /completedLoyaltyCards/{cardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /rewardsRedeemed/{redemptionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // User Training Progress (Legacy?)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Internal config
    match /_internal/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Rota
    match /rota/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
